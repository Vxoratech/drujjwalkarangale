# Copy to .env.local and fill in values from your Supabase project (Settings → API).
# Only the publishable/anon key belongs in the browser. NEVER put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
VITE_APP_ENV=development
